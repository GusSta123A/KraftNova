<?xml version="1.0" encoding="utf-8"?>
<!--
  web.config para Azure App Service (Windows) con Node.js via iisnode.
  Si usas Linux App Service, este archivo es ignorado — usa startup.sh.
-->
<configuration>
  <system.webServer>
    <handlers>
      <add name="iisnode" path="server.js" verb="*" modules="iisnode" />
    </handlers>

    <rewrite>
      <rules>
        <!-- No redirigir archivos estáticos de Next.js -->
        <rule name="StaticContent" stopProcessing="true">
          <match url="^(_next|favicon\.ico|robots\.txt|sitemap\.xml|.*\.(png|jpg|jpeg|gif|svg|ico|css|js|woff|woff2|ttf|eot))($|/)" />
          <action type="None" />
        </rule>
        <!-- Todo el resto va al servidor Next.js -->
        <rule name="NextJS" stopProcessing="true">
          <match url=".*" />
          <action type="Rewrite" url="server.js" />
        </rule>
      </rules>
    </rewrite>

    <iisnode
      node_env="production"
      nodeProcessCommandLine="node"
      interceptAllOutput="true"
      maxConcurrentRequestsPerProcess="1024"
      maxNamedPipeConnectionRetry="100"
      namedPipeConnectionRetryDelay="250"
      logDirectory="iisnode"
      debuggingEnabled="false"
    />

    <security>
      <requestFiltering>
        <hiddenSegments>
          <add segment="node_modules" />
          <add segment=".env.local" />
          <add segment=".env" />
        </hiddenSegments>
      </requestFiltering>
    </security>
  </system.webServer>
</configuration>
